# Cloud Run image for the read-only ops dashboard (spec 14).
# Scale-to-zero; never co-located with the trader money path.
FROM golang:1.25-alpine AS build
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/dashboard ./cmd/dashboard

FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /app
COPY --from=build /out/dashboard /app/dashboard
COPY config/ /app/config/

EXPOSE 8080
ENV PORT=8080
ENTRYPOINT ["/app/dashboard"]
CMD ["--config", "config/config.dashboard.cloudrun.yaml"]
