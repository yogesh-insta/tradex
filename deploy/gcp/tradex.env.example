# Copy to /etc/tradex/tradex.env on the VM (mode 0640, root:tradex).
# Never commit real values. Local laptop bootstrap: copy from repo-root .env.

TRADEX_ENV=demo

# OANDA
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID_EU=
OANDA_ACCOUNT_ID_FX=

# Control plane HMAC (09-control-plane.md)
CONTROL_HMAC_SECRET=

# Telegram notifier (12-observability-and-alerts.md)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional calendar provider
FINNHUB_API_KEY=
GEMINI_API_KEY=

# Optional dashboard bearer (14-dashboard.md) if co-hosted / sidecar
# DASHBOARD_TOKEN=
