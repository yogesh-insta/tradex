# Tradex live engine — systemd unit for the GCP VM.
# Install: sudo cp tradex.service /etc/systemd/system/ && sudo systemctl daemon-reload
# Secrets:  /etc/tradex/tradex.env (root:tradex 0640) — OANDA_API_TOKEN,
#           OANDA_ACCOUNT_ID_EU, CONTROL_HMAC_SECRET, TELEGRAM_BOT_TOKEN,
#           TELEGRAM_CHAT_ID. See deploy/gcp/tradex.env.example. Never in the unit file.

[Unit]
Description=Tradex automated trading engine (single OANDA writer)
After=network-online.target
Wants=network-online.target
OnFailure=tradex-failure-alert@%n.service

[Service]
Type=simple
User=tradex
Group=tradex
WorkingDirectory=/opt/tradex
ExecStart=/opt/tradex/bin/trader --config /opt/tradex/config/config.${TRADEX_ENV}.yaml
Environment=TRADEX_ENV=demo
EnvironmentFile=/etc/tradex/tradex.env
Restart=always
RestartSec=5
# Graceful shutdown: SIGTERM → publisher flush + goroutine drain (10s budget).
TimeoutStopSec=15
KillSignal=SIGTERM

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/tradex/data /opt/tradex/out
PrivateTmp=true

[Install]
WantedBy=multi-user.target
