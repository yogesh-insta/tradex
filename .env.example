# Copy to .env and fill in. Never commit .env.
#
# Deploy scripts read these; export them first, e.g.
#   set -a; source .env; set +a; ./deploy/scripts/deploy-nserotator.sh
# A plain `source .env` sets shell variables without exporting them, so the
# deploy script would not see any of it.

# --- Dashboard (Cloud Run, read-only ops UI) ---
DASHBOARD_TOKEN=

# --- Telegram (alert channel for the NSE rotator and ASX ETF monitor) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- GCP ---
GCP_PROJECT_ID=tradex-dev
