# Copy to .env and fill in. Never commit .env.
# Sibling sources when bootstrapping:
#   ../fxtrade/.credentials          — OANDA practice, email/SMTP, Finnhub
#   ../fxtrade/deploy/gcp/terraform  — GCP zone / admin CIDR / SSH patterns
#   ../tradey/.env                   — Telegram (fxtrade uses email, not Telegram)

# --- OANDA ---
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID_EU=
# FX paper account (fxpractice), e.g. 101-011-39706277-004 — enable accounts.fx-usdjpy.active
OANDA_ACCOUNT_ID_FX=

# --- Control plane / dashboard ---
CONTROL_HMAC_SECRET=
DASHBOARD_TOKEN=

# --- Telegram (Tradex primary alert channel; specs 12 / 14) ---
NOTIFY_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email (optional; copied from fxtrade-style alerts) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# --- Calendar poller (cmd/calendarpoller; Finnhub → Gemini → Telegram → file) ---
FINNHUB_API_KEY=
GEMINI_API_KEY=

# --- GCP (deploy / ops; GitHub Environments use GCP_VM_* secrets) ---
GCP_PROJECT_ID=tradex-dev
GCP_ZONE=us-east1-b
GCP_ADMIN_CIDR=
GCP_VM_HOST=
GCP_VM_USER=
GCP_VM_NAME=tradex-vm
